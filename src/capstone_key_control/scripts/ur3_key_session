#!/usr/bin/env python3
"""Run the MuJoCo planning stack and C++ keyboard in one terminal."""

import argparse
import os
import signal
import subprocess
import sys
import time


def _stop_process(process, *, process_group=False, timeout=8.0):
    """Stop one child gracefully, then force it only if necessary."""
    if process is None or process.poll() is not None:
        return
    try:
        if process_group:
            os.killpg(process.pid, signal.SIGINT)
        else:
            process.send_signal(signal.SIGINT)
        process.wait(timeout=timeout)
        return
    except (ProcessLookupError, subprocess.TimeoutExpired):
        pass

    if process.poll() is None:
        if process_group:
            os.killpg(process.pid, signal.SIGTERM)
        else:
            process.terminate()
        try:
            process.wait(timeout=3.0)
        except subprocess.TimeoutExpired:
            if process_group:
                os.killpg(process.pid, signal.SIGKILL)
            else:
                process.kill()
            process.wait()


def _arguments():
    """Parse the small, simulation-only session interface."""
    parser = argparse.ArgumentParser(
        description=(
            'Start capstone MuJoCo, both planners, and the C++ key mode in '
            'one terminal.'
        )
    )
    parser.add_argument(
        '--execute',
        action='store_true',
        help='Enable MuJoCo trajectory execution; default is planning only.',
    )
    parser.add_argument(
        '--headless',
        action='store_true',
        help='Run MuJoCo without its interactive viewer.',
    )
    parser.add_argument(
        '--initial-pose',
        choices=('home', 'scan'),
        default='home',
    )
    parser.add_argument('--planning-time', type=float, default=5.0)
    parser.add_argument(
        '--startup-wait',
        type=float,
        default=3.5,
        help='Seconds to let controllers and planners start before keyboard.',
    )
    arguments = parser.parse_args()
    if arguments.planning_time <= 0.0:
        parser.error('--planning-time must be positive')
    if arguments.startup_wait < 0.0:
        parser.error('--startup-wait cannot be negative')
    return arguments


def main():
    """Own both child processes so q or Ctrl+C shuts down the whole session."""
    arguments = _arguments()
    execute = str(arguments.execute).lower()
    plan_only = str(not arguments.execute).lower()
    headless = str(arguments.headless).lower()
    launch_command = [
        'ros2',
        'launch',
        'capstone_bringup',
        'ur3_arm.launch.py',
        'backend:=mujoco',
        'planner:=interactive',
        f'initial_pose:={arguments.initial_pose}',
        f'planning_time:={arguments.planning_time}',
        f'plan_only:={plan_only}',
        f'execute:={execute}',
        f'headless:={headless}',
    ]

    launch_process = None
    keyboard_process = None
    try:
        print('[ur3_key_session] Starting MuJoCo and dual-planner stack.')
        launch_process = subprocess.Popen(
            launch_command,
            start_new_session=True,
        )

        deadline = time.monotonic() + arguments.startup_wait
        while time.monotonic() < deadline:
            if launch_process.poll() is not None:
                print(
                    '[ur3_key_session] Stack exited before keyboard startup.',
                    file=sys.stderr,
                )
                return launch_process.returncode or 1
            time.sleep(0.1)

        print('[ur3_key_session] Starting C++ keyboard. Press ? for help.')
        keyboard_process = subprocess.Popen(
            ['ros2', 'run', 'capstone_key_control', 'ur3_key_mode_node']
        )

        while True:
            keyboard_status = keyboard_process.poll()
            launch_status = launch_process.poll()
            if keyboard_status is not None:
                return keyboard_status
            if launch_status is not None:
                print(
                    '[ur3_key_session] Stack stopped; closing keyboard.',
                    file=sys.stderr,
                )
                return launch_status or 1
            time.sleep(0.1)
    except KeyboardInterrupt:
        return 130
    finally:
        _stop_process(keyboard_process)
        _stop_process(launch_process, process_group=True)


if __name__ == '__main__':
    sys.exit(main())
