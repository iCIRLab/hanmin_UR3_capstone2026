<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>capstone_bringup</name>
  <version>0.0.0</version>
  <description>Launch files for the verified UR3 and RealSense D435i hardware.</description>
  <maintainer email="ryoo@todo.todo">ryoo</maintainer>
  <license>MIT</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>capstone_manipulation</exec_depend>
  <exec_depend>capstone_mujoco</exec_depend>
  <exec_depend>capstone_perception</exec_depend>
  <exec_depend>capstone_planning</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
